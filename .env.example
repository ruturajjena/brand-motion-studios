# Lemon Squeezy API key — Settings > API in the dashboard
LEMONSQUEEZY_API_KEY=

# Lemon Squeezy webhook signing secret — set when creating the webhook
# endpoint in the dashboard pointing at /api/webhooks/lemonsqueezy
LEMONSQUEEZY_WEBHOOK_SECRET=

# Lemon Squeezy store id — Settings > Stores in the dashboard
LEMONSQUEEZY_STORE_ID=

# Variant ids for each plan — Products in the dashboard, one variant per plan
LEMONSQUEEZY_VARIANT_MONTHLY=
LEMONSQUEEZY_VARIANT_YEARLY=
LEMONSQUEEZY_VARIANT_LIFETIME=

# Canonical site URL, used as checkout redirect fallback
NEXT_PUBLIC_SITE_URL=https://brandmotion.in

# Supabase project — Settings > API in the dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — Settings > API. Server-only, never expose to
# the client. Used exclusively by the Lemon Squeezy webhook to write entitlements.
SUPABASE_SERVICE_ROLE_KEY=
